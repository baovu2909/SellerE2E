{
  "name": "seller-e2e",
  "version": "1.0.0",
  "description": "Tự động hoá trình duyệt (Playwright) cho AMF Seller — môi trường dev / test",
  "scripts": {
    "panel": "node --watch-path=panel/server.js --watch-path=panel/lib --watch-path=panel/explain-error.js panel/server.js",
    "test:dev": "cross-env ENV=dev playwright test",
    "test:test": "cross-env ENV=test playwright test",
    "test:dev:headed": "cross-env ENV=dev playwright test --headed",
    "test:test:headed": "cross-env ENV=test playwright test --headed",
    "ui:dev": "cross-env ENV=dev playwright test --ui",
    "ui:test": "cross-env ENV=test playwright test --ui",
    "login:dev": "cross-env ENV=dev playwright test --project=setup",
    "login:test": "cross-env ENV=test playwright test --project=setup",
    "record:dev": "npm run login:dev && playwright codegen --load-storage=.auth/dev.json https://dev-seller.amfshopvn.vn",
    "record:test": "npm run login:test && playwright codegen --load-storage=.auth/test.json https://test-seller.amfshopvn.vn",
    "create-stores:dev": "cross-env ENV=dev playwright test --project=data tests/data/create-stores.spec.ts",
    "create-stores:test": "cross-env ENV=test playwright test --project=data tests/data/create-stores.spec.ts",
    "lockout:dev": "cross-env ENV=dev playwright test --project=flows tests/flows/login-lockout.spec.ts",
    "lockout:test": "cross-env ENV=test playwright test --project=flows tests/flows/login-lockout.spec.ts",
    "roles:dev": "cross-env ENV=dev playwright test --project=roles --workers=7",
    "roles:test": "cross-env ENV=test playwright test --project=roles --workers=7",
    "revenue:dev": "cross-env ENV=dev playwright test --project=reports tests/reports/revenue-sync.spec.ts",
    "revenue:test": "cross-env ENV=test playwright test --project=reports tests/reports/revenue-sync.spec.ts",
    "category:dev": "cross-env ENV=dev playwright test --project=features tests/features/category.spec.ts",
    "category:test": "cross-env ENV=test playwright test --project=features tests/features/category.spec.ts",
    "category-tax:dev": "cross-env ENV=dev playwright test --project=features tests/features/category-tax.spec.ts",
    "category-tax:test": "cross-env ENV=test playwright test --project=features tests/features/category-tax.spec.ts",
    "product:dev": "cross-env ENV=dev playwright test --project=features tests/features/product.spec.ts",
    "product:test": "cross-env ENV=test playwright test --project=features tests/features/product.spec.ts",
    "report:dev": "playwright show-report playwright-report/dev",
    "report:test": "playwright show-report playwright-report/test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4"
  }
}
